| {{ if or (.Paginator.HasPrev) (.Paginator.HasNext) }}
nav.pagination(role='pagination')
  | {{ if .Paginator.HasPrev }}
  a.newer-posts(href='{{.Paginator.Prev.URL}}')
    i.icon.icon-angles-left
    |   
  | {{ end }}
  span.post-list-pagination-item.post-list-pagination-item-current Page {{.Paginator.PageNumber}} of {{.Paginator.TotalPages}}
  | {{ if .Paginator.HasNext }}
  a.older-posts(href='{{.Paginator.Next.URL}}')
    |   
    i.icon.icon-angles-right
  | {{ end }}
| {{ end }}
