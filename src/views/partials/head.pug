//- HTTP
meta(charset='utf-8')
meta(http-equiv='X-UA-Compatible' content='IE=edge')
meta(http-equiv='content-language' content='{{ .Site.Language.Locale }}')
meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
meta(name='application-name' content='{{ .Site.Title }}')
meta(name='generator' content='Hugo')
meta(name='google' content='notranslate')

//- SEO, SOCIAL, STRUCTURED DATA (page-aware) — see partials/seo/meta.html
include seo/meta.html

//- FEED & ICONS
link(rel='alternate' type='application/rss+xml' title='{{ .Site.Title }}' href!='{{ with .OutputFormats.Get "RSS" }}{{ .RelPermalink }}{{ else }}{{ absURL "index.xml" }}{{ end }}')
link(rel='icon' type='image/svg+xml' sizes='any' href!='{{ absURL "images/brand/logo.svg" }}')
link(rel='icon' type='image/x-icon' href!='{{ absURL "images/brand/favicon.ico" }}')
link(rel='mask-icon' type='image/svg+xml' href!='{{ absURL "images/brand/logo.svg" }}' color='#10171e')
link(rel='apple-touch-icon' type='image/svg+xml' href!='{{ absURL "images/brand/logo.svg" }}')
link(rel='manifest' href!='{{ absURL ".manifest.json" }}')

//- APPLE / MICROSOFT
meta(name='apple-mobile-web-app-capable' content='yes')
meta(name='apple-mobile-web-app-title' content='{{ .Site.Title }}')
meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
meta(name='mobile-web-app-capable' content='yes')
meta(name='msapplication-config' content!='{{ absURL ".msconfig.xml" }}')
meta(name='msapplication-TileColor' content='#10171e')

//- STYLES
//- Heading font is self-hosted (see @font-face in main.scss); preload it so it
//- is fetched in parallel with the stylesheet instead of after it. relURL, not
//- absURL: fonts are CORS-restricted, so the request must stay same-origin
//- even when the page is reached through a host other than the baseURL.
link(rel='preload' href!='{{ relURL "fonts/montserrat-latin-700-normal.woff2" }}' as='font' type='font/woff2' crossorigin='')
link(rel='stylesheet' type='text/css' href!='{{ absURL "styles/main.min.css" }}')

//- SCRIPTS
//- Theme bootstrap, inlined at Pug compile time from src/scripts/theme.js: it
//- must run before first paint to apply the stored theme without a flash, and
//- inlining costs no request. Hugo's --minify compresses it in production.
script
  include ../../scripts/theme.js

//- GOOGLE ANALYTICS
| {{ with .Site.Params.google_analytics }}
script(async='' src='https://www.googletagmanager.com/gtag/js?id={{ . }}')
script.
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ . }}');
| {{ end }}
