//- HTTP
meta(charset='utf-8')
meta(http-equiv='X-UA-Compatible' content='IE=edge')
meta(http-equiv='content-language' content='{{ .Site.Language.Locale }}')
meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
meta(name='application-name' content='{{ .Site.Title }}')
meta(name='generator' content='Hugo')
meta(name='google' content='notranslate')

//- SEO, SOCIAL, STRUCTURED DATA (page-aware) — see partials/seo/meta.html
include seo/meta.html

//- FEED & ICONS
link(rel='alternate' type='application/rss+xml' title='{{ .Site.Title }}' href!='{{ with .OutputFormats.Get "RSS" }}{{ .RelPermalink }}{{ else }}{{ absURL "index.xml" }}{{ end }}')
link(rel='icon' type='image/svg+xml' sizes='any' href!='{{ absURL "images/brand/logo.svg" }}')
link(rel='icon' type='image/x-icon' href!='{{ absURL "images/brand/favicon.ico" }}')
link(rel='mask-icon' type='image/svg+xml' href!='{{ absURL "images/brand/logo.svg" }}' color='#10171e')
link(rel='apple-touch-icon' type='image/svg+xml' href!='{{ absURL "images/brand/logo.svg" }}')
link(rel='manifest' href!='{{ absURL ".manifest.json" }}')

//- APPLE / MICROSOFT
meta(name='apple-mobile-web-app-capable' content='yes')
meta(name='apple-mobile-web-app-title' content='{{ .Site.Title }}')
meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
meta(name='mobile-web-app-capable' content='yes')
meta(name='msapplication-config' content!='{{ absURL ".msconfig.xml" }}')
meta(name='msapplication-TileColor' content='#10171e')

//- STYLES
link(rel='preconnect' href='https://fonts.googleapis.com')
link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
link(rel='preconnect' href='https://cdnjs.cloudflare.com')
link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css' type='text/css')
link(rel='stylesheet' type='text/css' href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300|Montserrat:700&display=swap')
link(rel='stylesheet' type='text/css' href!='{{ absURL "styles/main.min.css" }}')

//- SCRIPTS
script(src!='{{ absURL "scripts/theme.js" }}')
script(src='https://kit.fontawesome.com/60b7ab0066.js' crossorigin='anonymous')
script(src='https://code.jquery.com/jquery-3.4.1.min.js')
script(id='MathJax-script' async='' src='https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js')

//- GOOGLE ANALYTICS
| {{ with .Site.Params.google_analytics }}
script(async='' src='https://www.googletagmanager.com/gtag/js?id={{ . }}')
script.
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ . }}');
| {{ end }}
